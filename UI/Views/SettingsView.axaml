<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.Views.SettingsView"
             xmlns:views="using:UI.Views.SettingsTabs"
             xmlns:settings="clr-namespace:UI.ViewModels.Settings"
             xmlns:vm="clr-namespace:UI.ViewModels"
             x:DataType="vm:SettingsViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type settings:GeneralSettingsViewModel}">
            <views:GeneralSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:YoutubeSettingsViewModel}">
            <views:YoutubeSettingsView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <TabControl ItemsSource="{Binding Tabs}">
        <TabControl.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Title}" />
            </DataTemplate>
        </TabControl.ItemTemplate>
    </TabControl>

</UserControl>