<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI.Views.PlaylistView"
             x:DataType="vm:PlaylistViewModel">

    <Design.DataContext>
        <vm:PlaylistViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="75*, 25*">
        <Border>
            <Image Source="{Binding CurrentSong?.Image}" />
        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="Auto, *"
              RowSpacing="10">
            <Grid ColumnDefinitions="*, Auto, Auto"
                  Margin="0 10 10 0">
                <Label Content="{Binding Playlist?.Name}" />

                <Button Grid.Column="1"
                        Command="{Binding ShuffleCommand}">
                    <PathIcon Data="{StaticResource ShuffleIcon}" />
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsRefreshing}">
                    <PathIcon Data="{StaticResource RefreshIcon}" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Songs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="0"
                                        Command="{Binding $parent[ItemsControl].((vm:PlaylistViewModel)DataContext)?.SetSongCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        Height="100">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Image Source="{Binding Image}" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Vertical">
                                            <Label Content="{Binding Title}" />
                                            <Label Content="{Binding Artist}" />
                                            <Label Content="Current playing" IsVisible="{Binding IsSelected}" />
                                        </StackPanel>
                                        <Label Grid.Column="2"
                                               Content="{Binding Duration}"
                                               VerticalAlignment="Bottom" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>